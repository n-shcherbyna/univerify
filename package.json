{
    "name": "univerify",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "npm -w @univerify/verifier-core run build && npm -w @univerify/verifier-cli run build && npm -w web run build",
        "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url $RPC_URL --private-key $OWNER_PK --broadcast",
        "sync:env:sepolia": "CHAIN_ID=11155111 dotenv -e .env node scripts/sync-env.mjs",
        "sync:env:mainnet": "CHAIN_ID=1 dotenv -e .env node scripts/sync-env.mjs"
    },
    "devDependencies": {
        "dotenv-cli": "^11.0.0"
    }
}
